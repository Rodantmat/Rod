{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alphadog-expansion-v001",
  "main": "worker.js",
  "compatibility_date": "2026-04-24",
  "vars": {
    "XP_SYSTEM_VERSION": "v0.1.24 - Deployment File Naming Fix",
    "XP_ALLOWED_SOURCE_TABLE": "prizepicks_current_market_context"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prop-engine-db",
      "database_id": "ec21a626-1b31-45fd-816c-5baf5609a6c3"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
